# Copy to ".env.cloud" for local cloud runs and fill values.

# CORS / DB
CLOUD_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_DB_PATH=cloud/data/cloud.db

# Signaling TTL
SIGNALING_OFFER_TTL_SEC=30
SIGNALING_ANSWER_TTL_SEC=30
SIGNALING_ICE_TTL_SEC=20
EDGE_SHARED_SECRET=replace-with-a-long-random-secret
EDGE_SIGNATURE_TTL_SEC=30

# Auth
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=ChangeMe123!
AUTH_JWT_SECRET=change-this-in-production
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_SEC=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Clip retention
CLIP_STORAGE_DIR=cloud/data/clips
CLIP_RETENTION_DAYS=7
CLIP_CLEANUP_INTERVAL_SEC=3600
CLIP_PRESIGNED_URL_TTL_SEC=300

# AWS S3 upload
AWS_S3_BUCKET=replace-with-your-bucket-name
AWS_REGION=ap-northeast-2

# Weather risk
# 공공데이터포털 기상청 ASOS 시간자료 API 인증키입니다.
# KMA_API_KEY가 비어 있으면 기상 위험도 계산은 비활성화됩니다.
KMA_API_KEY=
KMA_ASOS_STATION_NO=119
