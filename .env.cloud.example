# Copy to ".env.cloud" (or ".env" on EC2) and fill values.

# CORS / DB
CLOUD_CORS_ALLOW_ORIGINS=http://localhost:3000
LOCAL_DB_PATH=cloud/data/cloud.db

# Signaling TTL
SIGNALING_OFFER_TTL_SEC=30
SIGNALING_ANSWER_TTL_SEC=30
SIGNALING_ICE_TTL_SEC=20

# Auth
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=ChangeMe123!
AUTH_JWT_SECRET=change-this-in-production
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_SEC=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Edge HMAC auth (required)
EDGE_SHARED_SECRET=replace-with-long-random-secret
EDGE_AUTH_SKEW_SEC=30

# WebRTC ICE (JSON array)
WEBRTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Clip retention
CLIP_STORAGE_DIR=cloud/data/clips
CLIP_RETENTION_DAYS=7
CLIP_CLEANUP_INTERVAL_SEC=3600

# AWS S3 upload/presigned
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
PRESIGNED_URL_TTL_SEC=300

# Optional legacy credentials (prefer EC2 IAM Role)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
