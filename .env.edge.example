# Copy this file to ".env.edge" and customize per computer.
# scripts/run_edge.sh loads this file automatically.

# Core identity/network
EDGE_ID=edge-default
CLOUD_BASE_URL=http://localhost:8000

# Hardware (set these per machine)
EDGE_CAMERA_SOURCE=0
EDGE_SERIAL_PORT=/dev/ttyUSB0
EDGE_SERIAL_BAUD=9600
EDGE_SERIAL_MOCK=false

# Polling
EDGE_COMMAND_POLL_INTERVAL=0.3
EDGE_ZONE_POLL_INTERVAL=5.0
EDGE_HEARTBEAT_INTERVAL=1.0

# Models
EDGE_PERSON_MODEL_PATH=edge/models/yolov8n.pt
EDGE_FALL_MODEL_PATH=edge/models/fall_det_1.pt
EDGE_PERSON_CONF=0.3
EDGE_FALL_CONF=0.4

# Overlay
EDGE_VISUAL_OVERLAY_ENABLED=true
EDGE_DRAW_ZONE_POLYGONS=true
EDGE_DRAW_LABEL_CONFIDENCE=false
