[Unit]
Description=Conveyor Guard Cloud API (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/stop
EnvironmentFile=/home/ubuntu/app/stop/.env
ExecStart=/home/ubuntu/app/stop/.venv-cloud/bin/uvicorn cloud.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
