# Core cloud configuration
EDGE_SHARED_SECRET=replace-with-a-long-random-secret
EDGE_SIGNATURE_TTL_SEC=30
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=ChangeMe123!
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
CLOUD_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_DB_PATH=/app/cloud/data/cloud.db
CONVEYOR_DATA_DIR=./.deploy/cloud-data
KMA_API_KEY=replace-with-your-data-go-kr-service-key
KMA_ASOS_STATION_NO=119
WEATHER_REFRESH_INTERVAL_SEC=600
KAKAO_REST_API_KEY=replace-with-your-kakao-rest-api-key

# S3 clip storage
AWS_S3_BUCKET=replace-with-your-bucket-name
AWS_REGION=ap-northeast-2
CLIP_PRESIGNED_URL_TTL_SEC=300

# Frontend build-time values
REACT_APP_API_BASE_URL=
REACT_APP_WS_BASE_URL=
REACT_APP_EDGE_ID=edge-default
REACT_APP_WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:<EC2_PUBLIC_IP>:3478","turn:<EC2_PUBLIC_IP>:3478?transport=udp","turn:<EC2_PUBLIC_IP>:3478?transport=tcp"],"username":"turnuser","credential":"turnpassword"}]

# Caddy / TURN
CADDY_DOMAIN=:80
TURN_PUBLIC_IP=<EC2_PUBLIC_IP>
TURN_REALM=<EC2_PUBLIC_IP>
TURN_USER=turnuser
TURN_PASSWORD=turnpassword
