# =========
# Public host / TLS
# =========
CADDY_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# =========
# Cloud app
# =========
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=ChangeMe123!
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=example.com
CLOUD_CORS_ALLOW_ORIGINS=https://example.com

# Edge HMAC auth
EDGE_SHARED_SECRET=replace-with-long-random-secret
EDGE_AUTH_SKEW_SEC=30

# WebRTC ICE (shared by edge/frontend)
WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# Storage / DB
CONVEYOR_DATA_DIR=/srv/conveyor/data
LOCAL_DB_PATH=/app/cloud/data/cloud.db

# S3 (prefer EC2 IAM Role, credentials optional)
AWS_S3_BUCKET=your-private-bucket-name
AWS_REGION=ap-northeast-2
PRESIGNED_URL_TTL_SEC=300
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# =========
# Frontend build args
# =========
REACT_APP_API_BASE_URL=
REACT_APP_WS_BASE_URL=
REACT_APP_EDGE_ID=edge-default
REACT_APP_WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# =========
# coturn
# =========
TURN_REALM=example.com
TURN_USER=turnuser
TURN_PASSWORD=turnpassword
